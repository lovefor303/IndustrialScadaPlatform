<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Scada.Controls.Wpf">
  <SolidColorBrush x:Key="ScadaBrush.#202428" Color="#202428" />
  <SolidColorBrush x:Key="ScadaBrush.#D4D9DC" Color="#D4D9DC" />
  <SolidColorBrush x:Key="ScadaBrush.#929BA1" Color="#929BA1" />
  <SolidColorBrush x:Key="ScadaBrush.#343B40" Color="#343B40" />
  <SolidColorBrush x:Key="ScadaBrush.#7E878D" Color="#7E878D" />
  <SolidColorBrush x:Key="ScadaBrush.#2E9D62" Color="#2E9D62" />
  <SolidColorBrush x:Key="ScadaBrush.#D79B2B" Color="#D79B2B" />
  <SolidColorBrush x:Key="ScadaBrush.#D64045" Color="#D64045" />
  <SolidColorBrush x:Key="ScadaBrush.#697278" Color="#697278" />
  <SolidColorBrush x:Key="ScadaBrush.transparent" Color="Transparent" />

  <Style TargetType="{x:Type local:IndustrialControl}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:IndustrialControl}">
          <Border Background="Transparent" SnapsToDevicePixels="True">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="EquipmentState">
                <VisualState x:Name="Neutral" />
                <VisualState x:Name="Stopped" />
                <VisualState x:Name="Active" />
                <VisualState x:Name="Transition" />
                <VisualState x:Name="Fault" />
                <VisualState x:Name="Unknown" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="QualityState">
                <VisualState x:Name="GoodQuality" />
                <VisualState x:Name="UnknownQuality" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Canvas x:Name="PART_Root" ClipToBounds="False" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
