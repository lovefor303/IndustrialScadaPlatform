<Window x:Class="Scada.Editor.Wpf.EditorShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Scada.Editor.Wpf"
        Title="工业组态编辑器"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        Background="#1F2429"
        Foreground="#E6EDF3"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="G" Modifiers="Control" Command="{Binding GroupCommand}" />
        <KeyBinding Key="G" Modifiers="Control+Shift" Command="{Binding UngroupCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#252B31" Foreground="#E6EDF3">
            <MenuItem Header="文件">
                <MenuItem Header="新建项目" Command="{Binding NewProjectCommand}" />
                <MenuItem Header="打开项目" Command="{Binding OpenProjectCommand}" />
                <Separator />
                <MenuItem Header="保存草稿" Command="{Binding SaveDraftCommand}" />
                <MenuItem Header="发布版本" Command="{Binding PublishCommand}" />
                <MenuItem Header="恢复版本" Command="{Binding RestoreCommand}" />
            </MenuItem>
            <MenuItem Header="编辑">
                <MenuItem Header="撤销" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="重做" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="左对齐" Command="{Binding AlignLeftCommand}" />
                <MenuItem Header="水平居中" Command="{Binding AlignCenterCommand}" />
                <MenuItem Header="右对齐" Command="{Binding AlignRightCommand}" />
                <MenuItem Header="顶端对齐" Command="{Binding AlignTopCommand}" />
                <MenuItem Header="垂直居中" Command="{Binding AlignMiddleCommand}" />
                <MenuItem Header="底端对齐" Command="{Binding AlignBottomCommand}" />
                <MenuItem Header="水平等距" Command="{Binding DistributeHorizontalCommand}" />
                <MenuItem Header="垂直等距" Command="{Binding DistributeVerticalCommand}" />
                <Separator />
                <MenuItem Header="组合" Command="{Binding GroupCommand}" InputGestureText="Ctrl+G" />
                <MenuItem Header="取消组合" Command="{Binding UngroupCommand}" InputGestureText="Ctrl+Shift+G" />
                <MenuItem Header="置于顶层" Command="{Binding BringToFrontCommand}" />
                <MenuItem Header="置于底层" Command="{Binding SendToBackCommand}" />
            </MenuItem>
            <MenuItem Header="视图">
                <MenuItem Header="网格" />
                <MenuItem Header="标尺" />
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top" Background="#2B3239">
            <Button Content="新建" Command="{Binding NewProjectCommand}" Margin="2" Padding="10,4" />
            <Button Content="打开" Command="{Binding OpenProjectCommand}" Margin="2" Padding="10,4" />
            <Button Content="保存草稿" Command="{Binding SaveDraftCommand}" Margin="2" Padding="10,4" />
            <Separator />
            <Button Content="撤销" Command="{Binding UndoCommand}" Margin="2" Padding="10,4" />
            <Button Content="重做" Command="{Binding RedoCommand}" Margin="2" Padding="10,4" />
            <Button Content="左对齐" Command="{Binding AlignLeftCommand}" Margin="2" Padding="10,4" />
            <Button Content="水平等距" Command="{Binding DistributeHorizontalCommand}" Margin="2" Padding="10,4" />
            <Button Content="组合" Command="{Binding GroupCommand}" Margin="2" Padding="10,4" />
            <Button Content="取消组合" Command="{Binding UngroupCommand}" Margin="2" Padding="10,4" />
            <Separator />
            <Button Content="缩小" Margin="2" Padding="10,4" />
            <Button Content="放大" Margin="2" Padding="10,4" />
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom" Background="#252B31" Foreground="#B9C3CC">
            <StatusBarItem Content="绑定状态：离线编辑" />
            <Separator />
            <StatusBarItem Content="{Binding StatusText}" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ToolboxPanel"
                    Grid.Column="0"
                    Margin="8"
                    Padding="8"
                    Background="#252B31"
                    BorderBrush="#3B4650"
                    BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="4,2,4,10"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="工具箱" />
                    <TreeView x:Name="ToolboxTree"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="#E6EDF3">
                        <TreeViewItem Header="设备">
                            <TreeViewItem Header="离心泵" />
                            <TreeViewItem Header="自动阀" />
                            <TreeViewItem Header="容器" />
                            <TreeViewItem Header="搅拌器" />
                            <TreeViewItem Header="过滤器" />
                        </TreeViewItem>
                        <TreeViewItem Header="管道与仪表">
                            <TreeViewItem Header="直管" />
                            <TreeViewItem Header="弯头" />
                            <TreeViewItem Header="数值显示" />
                            <TreeViewItem Header="液位柱" />
                            <TreeViewItem Header="温度仪表" />
                            <TreeViewItem Header="压力仪表" />
                        </TreeViewItem>
                        <TreeViewItem Header="文本与操作">
                            <TreeViewItem Header="文本标签" />
                            <TreeViewItem Header="操作按钮" />
                        </TreeViewItem>
                    </TreeView>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Margin="0,8,8,8"
                    Background="#171B1F"
                    BorderBrush="#3B4650"
                    BorderThickness="1">
                <local:EditorCanvas x:Name="ProcessCanvas" />
            </Border>

            <Border Grid.Column="2"
                    Margin="0,8,8,8"
                    Background="#252B31"
                    BorderBrush="#3B4650"
                    BorderThickness="1">
                <TabControl x:Name="InspectorTabs"
                            Background="#252B31"
                            BorderThickness="0"
                            Foreground="#E6EDF3">
                    <TabItem Header="属性">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PropertyPanel" Margin="12">
                                <TextBlock FontWeight="SemiBold" Text="对象属性" />
                                <TextBlock Margin="0,10,0,2" Text="位置与尺寸" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,3,6,3" Text="X" />
                                    <TextBox Grid.Column="1" Margin="0,0,8,4" />
                                    <TextBlock Grid.Column="2" Margin="0,3,6,3" Text="Y" />
                                    <TextBox Grid.Column="3" Margin="0,0,0,4" />
                                </Grid>
                                <TextBlock Margin="0,8,0,2" Text="旋转角度" />
                                <TextBox />
                                <CheckBox Margin="0,10,0,0" Content="可见" IsChecked="True" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="变量">
                        <StackPanel x:Name="BindingPanel" Margin="12">
                            <TextBlock FontWeight="SemiBold" Text="变量绑定" />
                            <TextBlock Margin="0,8,0,2" Text="控件变量角色" />
                            <ComboBox />
                            <TextBlock Margin="0,8,0,2" Text="项目变量" />
                            <ComboBox />
                            <Button Margin="0,10,0,0" Content="应用绑定" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="动态">
                        <StackPanel x:Name="DynamicsPanel" Margin="12">
                            <TextBlock FontWeight="SemiBold" Text="动态设置" />
                            <TextBlock Margin="0,8,0,2" Text="目标属性" />
                            <ComboBox />
                            <TextBlock Margin="0,8,0,2" Text="驱动变量" />
                            <ComboBox />
                            <TextBlock Margin="0,8,0,2" Text="条件（可选）" />
                            <TextBox />
                            <Button Margin="0,10,0,0" Content="应用动态" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="事件">
                        <StackPanel x:Name="EventsPanel" Margin="12">
                            <TextBlock FontWeight="SemiBold" Text="事件与动作" />
                            <TextBlock Margin="0,8,0,2" Text="事件" />
                            <ComboBox />
                            <TextBlock Margin="0,8,0,2" Text="动作" />
                            <ComboBox />
                            <Button Margin="0,10,0,0" Content="应用事件" />
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </DockPanel>
</Window>
